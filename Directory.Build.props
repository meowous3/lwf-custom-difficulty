<Project>
  <PropertyGroup>
    <!--
      Point this at your game folder - the one containing LazyWitchFactory.exe.
      This is the only line most people need to change.

      Deliberately unconditional: the default path contains an apostrophe, and
      MSBuild delimits Condition strings with single quotes, so any condition
      referencing this property fails to parse. Edit the value directly.

      Windows example:
        <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Lazy Witch's Factory Demo</GameDir>
    -->
    <GameDir>$(HOME)/.local/share/Steam/steamapps/common/Lazy Witch's Factory Demo</GameDir>

    <GameManagedDir>$(GameDir)/LazyWitchFactory_Data/Managed</GameManagedDir>
    <BepInExCoreDir>$(GameDir)/BepInEx/core</BepInExCoreDir>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
